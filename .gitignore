# ── 依赖 ────────────────────────────────────────────────────────────
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# ── 二进制 / Electron 运行时（体积大、可重建，且 exe 超 GitHub 100MB 限制）──
*.exe
*.dll
*.pdb
*.node
*.pak
*.bin
*.dat
*.asar
*.asar.unpacked/
*.asar.old

# ── Electron 运行时：整体排除，只放行报告模板 ───────────────────────
# （exe/dll/pak/许可证 等几百 MB，且 exe 超 GitHub 100MB 单文件限制）
perfara/collector/**
!perfara/collector/resources/
!perfara/collector/resources/reports/
!perfara/collector/resources/reports/*.html

# ── 便携版产物副本（与 perfara/collector 重复）──────────────────────
Perfara-Portable/

# ── 构建中间产物（保留 .spec 构建配置）──────────────────────────────
build/**/build/
build/**/dist/
build/portable-work/
build/portable-spec/
build/launcher/Perfara/
perfara/build/
perfara/dist/
*.manifest
_evidence_*/
_perfdog_opt_evidence/
_asar_*/
_backup_*/
_removed-from-portable/
# 移除 perfara.apk 依赖后归档的 APK（5.6MB，不入库）
_archive_removed_apk/
# 新增的便携版产物：安装包按需单独分发，避免每次构建都把 200MB+ 推上 LFS
# （旧规则只挡 `*_r*.zip`，`_20261021.zip` 这类日期包会漏进暂存区）
release/*.zip
# 交付目录整体不入库：内含 app.asar（1.7MB）+ 报告模板 + 说明文档，
# 这些都是构建产物，源码在 _client_src/ 与 perfara/collector/resources/ 里已有
release/交付_*/
# 根目录散落的过程截图（各阶段验证用，归档在 F 盘）
/*.png

# ── 客户端源码中体积大且无需入库的资源 ──────────────────────────────
# iOS 调试镜像（运行期联网挂载）
_client_src/app/devimages/
# 推广素材（含 3.4MB 视频）
_client_src/app/推广web/
# 运行期实际用包外 resources/ios-tools
_client_src/app/ios脚本/
_client_src/app/*.zip

# ── OS / 编辑器 ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
.env

# ── 运行日志 ────────────────────────────────────────────────────────
*.log
logs/

# ── 本地数据（含采集数据、数据库）──────────────────────────────────
perfara/data/
*.db
*.sqlite3

# ── 工作区元数据 ────────────────────────────────────────────────────
.workbuddy/
.workbuddy-ai/

# ── 从发布包移出的体积项（保留在本地备查，不进 git）────────────────
# 例：_archive_removed/ios-tools-bin/lowgpu.json（27.7MB，运行期无引用）
_archive_removed/

# ── 运行期产物（采集端本地报告归档，测试也会生成）────────────────────
_client_src/app/reports/

# ── 发布期临时产物（修复效果图等，不入库）──────────────────────────────────
release/修复效果图_*/
# 泄漏审计用的敏感串模式文件：含真实序列号/机型/包名，绝不能入库
release/_audit/
